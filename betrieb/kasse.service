# systemd: /etc/systemd/system/kasse.service
[Unit]
Description=kasse - PDF-Verkauf gegen QR-Rechnung
After=network.target

[Service]
ExecStart=/usr/local/bin/kasse --konfig /etc/kasse/kasse.toml
User=kasse
Group=kasse
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kasse
PrivateTmp=true

[Install]
WantedBy=multi-user.target
